{
  "required": true,
  "package": "com.ludwici.cobblewatchcore.mixin",
  "compatibilityLevel": "JAVA_21",
  "mixins": [
    "server.CapsuleItemMixin",
    "cards.CobblemonCardsConfigMixin",
    "cards.CardStatUtilMixin",
    "weather.AtmosphericStateMixin",
    "weather.WeatherScenarioMixin",
    "weather.ScenarioSelectorMixin",
    "weather.WeatherEngineMixin",
    "rustlingspots.SpotRewardResolverMixin"
  ],
  "injectors": {
    "defaultRequire": 1
  },
  "overwrites": {
    "requireAnnotations": true
  },
  "client": [
    "client.ClientPacketListenerMixin",
    "client.BinderScreenMixin"
  ],
  "plugin": "com.ludwici.cobblewatchcore.mixin.CoreMixinPlugin"
}
